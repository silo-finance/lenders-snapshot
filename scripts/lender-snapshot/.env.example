# Copy to .env and fill in. The real .env is gitignored and must never be committed.

# Archive RPC endpoint for Sonic (must support eth_call at the historical block).
SONIC_RPC_URL=

# Optional fallback RPC endpoint used if a chain-specific URL is not set.
RPC_URL=

# Future Ethereum archive RPC endpoint. Only required once Ethereum silos are configured.
ETHEREUM_RPC_URL=

# The Graph gateway Bearer token.
THE_GRAPH_API_KEY=
